{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$metadata": {
    "name": "PoolConnection Design Tokens",
    "version": "1.0",
    "updated": "2026-04-27",
    "description": "Single source of truth for all visual values. Compatible with Style Dictionary, Figma Tokens plugin, and Theo."
  },

  "color": {
    "neutral": {
      "black":      { "$value": "#191919", "$type": "color", "$description": "Primary text, primary buttons" },
      "nearBlack":  { "$value": "#252525", "$type": "color", "$description": "Hover state for black elements" },
      "grayDark":   { "$value": "#37352F", "$type": "color", "$description": "Body text — use instead of pure black" },
      "grayMid":    { "$value": "#6B6B6B", "$type": "color", "$description": "Secondary text, labels" },
      "grayLight":  { "$value": "#9B9A97", "$type": "color", "$description": "Placeholder, eyebrows, captions" },
      "grayLine":   { "$value": "#E9E9E7", "$type": "color", "$description": "Borders, dividers, table lines" },
      "grayBg":     { "$value": "#F7F7F5", "$type": "color", "$description": "Page backgrounds, row hovers" },
      "white":      { "$value": "#FFFFFF", "$type": "color", "$description": "Card backgrounds, inputs" }
    },
    "brand": {
      "waterDeep":  { "$value": "#0A3554", "$type": "color", "$description": "Logo background — do not use as large bg" },
      "waterMid":   { "$value": "#1565A0", "$type": "color", "$description": "Score ring, progress bars, links" },
      "waterLight": { "$value": "#4A90C4", "$type": "color", "$description": "Secondary accents" },
      "waterPale":  { "$value": "#E8F4FA", "$type": "color", "$description": "Chip backgrounds, tinted surfaces" }
    },
    "semantic": {
      "good": {
        "fg": { "$value": "#0F7B6C", "$type": "color" },
        "bg": { "$value": "#EDFAF7", "$type": "color" }
      },
      "warning": {
        "fg": { "$value": "#C17D39", "$type": "color" },
        "bg": { "$value": "#FBF3E4", "$type": "color" }
      },
      "critical": {
        "fg": { "$value": "#C73535", "$type": "color" },
        "bg": { "$value": "#FEF3F2", "$type": "color" }
      },
      "info": {
        "fg": { "$value": "#2383E2", "$type": "color" },
        "bg": { "$value": "#EBF3FD", "$type": "color" }
      }
    }
  },

  "typography": {
    "fontFamily": {
      "ui":   { "$value": "'Inter', -apple-system, BlinkMacSystemFont, sans-serif", "$type": "fontFamily" },
      "read": { "$value": "'Newsreader', Georgia, serif", "$type": "fontFamily" }
    },
    "fontSize": {
      "display":  { "$value": "clamp(42px, 6.5vw, 72px)", "$type": "fontSize", "$description": "Hero H1 — Newsreader 300" },
      "h2":       { "$value": "clamp(28px, 3.5vw, 44px)", "$type": "fontSize", "$description": "Section headings — Newsreader 300" },
      "h3":       { "$value": "26px",  "$type": "fontSize", "$description": "Card titles — Newsreader 400" },
      "pageTitle":{ "$value": "28px",  "$type": "fontSize", "$description": "In-app page title — Newsreader 400" },
      "bodyLg":   { "$value": "18px",  "$type": "fontSize", "$description": "Body large — Inter 300" },
      "body":     { "$value": "16px",  "$type": "fontSize", "$description": "Body — Inter 400" },
      "bodySm":   { "$value": "15px",  "$type": "fontSize", "$description": "Body small — Inter 400" },
      "label":    { "$value": "13px",  "$type": "fontSize", "$description": "Data cells, labels — Inter 400" },
      "caption":  { "$value": "12px",  "$type": "fontSize", "$description": "Captions, eyebrows — Inter 400–500" },
      "micro":    { "$value": "11px",  "$type": "fontSize", "$description": "Tags, badges — Inter 500" }
    },
    "fontWeight": {
      "light":    { "$value": 300, "$type": "fontWeight" },
      "regular":  { "$value": 400, "$type": "fontWeight" },
      "medium":   { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" }
    },
    "lineHeight": {
      "display": { "$value": 1.1,  "$type": "lineHeight" },
      "heading": { "$value": 1.2,  "$type": "lineHeight" },
      "body":    { "$value": 1.6,  "$type": "lineHeight" },
      "bodyLg":  { "$value": 1.65, "$type": "lineHeight" },
      "label":   { "$value": 1.55, "$type": "lineHeight" }
    },
    "letterSpacing": {
      "display":  { "$value": "-0.5px", "$type": "letterSpacing" },
      "heading":  { "$value": "-0.3px", "$type": "letterSpacing" },
      "eyebrow":  { "$value": "1px",    "$type": "letterSpacing", "$description": "Uppercase section labels" },
      "badge":    { "$value": "0.5px",  "$type": "letterSpacing", "$description": "Table header uppercase" }
    }
  },

  "spacing": {
    "1":  { "$value": "4px",  "$type": "spacing", "$description": "Micro — icon-to-label, tag padding" },
    "2":  { "$value": "8px",  "$type": "spacing", "$description": "Tight component spacing" },
    "3":  { "$value": "12px", "$type": "spacing", "$description": "Internal component padding" },
    "4":  { "$value": "16px", "$type": "spacing", "$description": "Standard component padding" },
    "5":  { "$value": "20px", "$type": "spacing", "$description": "Card padding small" },
    "6":  { "$value": "24px", "$type": "spacing", "$description": "Standard section padding, card body" },
    "8":  { "$value": "32px", "$type": "spacing", "$description": "Larger card padding" },
    "10": { "$value": "40px", "$type": "spacing", "$description": "Section breathing room" },
    "14": { "$value": "56px", "$type": "spacing", "$description": "Between major sections" },
    "20": { "$value": "80px", "$type": "spacing", "$description": "Between major sections (wide)" }
  },

  "borderRadius": {
    "xs":   { "$value": "4px",    "$type": "borderRadius", "$description": "Buttons, tags, chips, inputs, callouts" },
    "sm":   { "$value": "6px",    "$type": "borderRadius", "$description": "Small cards, spots blocks" },
    "md":   { "$value": "8px",    "$type": "borderRadius", "$description": "Standard cards, feature lists" },
    "lg":   { "$value": "12px",   "$type": "borderRadius", "$description": "App preview browser frame" },
    "full": { "$value": "9999px", "$type": "borderRadius", "$description": "Pills" }
  },

  "shadow": {
    "card":  { "$value": "0 4px 24px rgba(0,0,0,0.06), 0 1px 3px rgba(0,0,0,0.04)", "$type": "shadow" },
    "float": { "$value": "0 4px 8px rgba(0,0,0,0.04), 0 16px 40px rgba(0,0,0,0.08)", "$type": "shadow" },
    "modal": { "$value": "0 24px 64px rgba(0,0,0,0.2)", "$type": "shadow" }
  },

  "transition": {
    "fast":   { "$value": "0.10s ease", "$type": "transition", "$description": "Row background hovers" },
    "base":   { "$value": "0.12s ease", "$type": "transition", "$description": "All interactive hover states" },
    "reveal": { "$value": "0.55s ease", "$type": "transition", "$description": "Scroll reveal animations" },
    "score":  { "$value": "1.8s cubic-bezier(0.16, 1, 0.3, 1)", "$type": "transition", "$description": "Health Score ring fill animation" }
  },

  "layout": {
    "maxWidthContent": { "$value": "680px",  "$description": "Reading width — FAQ, long-form" },
    "maxWidthHero":    { "$value": "760px",  "$description": "Centered hero" },
    "maxWidthLayout":  { "$value": "1100px", "$description": "Main page max width" },
    "sidebarWidth":    { "$value": "220px",  "$description": "App sidebar" },
    "topnavHeight":    { "$value": "52px",   "$description": "Fixed top nav height" }
  },

  "breakpoint": {
    "mobile":  { "$value": "600px",  "$description": "Hide nav text, stack hero, single column" },
    "tablet":  { "$value": "860px",  "$description": "Hide sidebar, single column layouts" },
    "desktop": { "$value": "860px",  "$description": "Full two-column layout threshold" }
  },

  "healthScore": {
    "ring": {
      "radius":        { "$value": 35,    "$description": "SVG circle radius" },
      "strokeWidth":   { "$value": 8,     "$description": "Track and fill stroke width" },
      "circumference": { "$value": 220,   "$description": "2π×35 ≈ 220 — used for dashoffset calc" },
      "viewbox":       { "$value": "0 0 88 88", "$description": "SVG viewport" },
      "trackColor":    { "$value": "{color.neutral.grayLine}" },
      "fillGood":      { "$value": "{color.brand.waterMid}",    "$description": "Score 80–100" },
      "fillWarn":      { "$value": "{color.semantic.warning.fg}", "$description": "Score 50–79" },
      "fillCritical":  { "$value": "{color.semantic.critical.fg}", "$description": "Score 0–49" },
      "numberFont":    { "$value": "{typography.fontFamily.read}", "$description": "28px Newsreader 400" },
      "animationDelay":{ "$value": "0.8s", "$description": "Let page settle before ring draws" }
    },
    "thresholds": {
      "good":     { "$value": 80, "$description": "Score >= 80 — Good condition" },
      "warn":     { "$value": 50, "$description": "Score 50–79 — Needs attention" },
      "critical": { "$value": 0,  "$description": "Score < 50 — Act now" }
    }
  }
}
